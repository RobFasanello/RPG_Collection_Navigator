DB_SERVER=FASARIG2
DB_DATABASE=TabletopInventory
DB_USER=
DB_PASSWORD=
PORT=3001
# Comma-separated allowlist. Leave empty to allow all origins.
# Example: http://localhost,http://rpg.local
CORS_ORIGINS=

# Google OAuth login
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# and register a redirect URI for every origin the app is reachable at, e.g.
# "http://localhost:3001/api/auth/callback" (dev, direct) and
# "http://localhost/api/auth/callback" (prod, via the IIS reverse proxy) —
# Google allows multiple redirect URIs on one client. The backend derives
# which one to use per-request from the incoming Host header, so no env var
# needs to change when you switch between them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ byte secret used to sign session cookies, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Leave unset. The backend derives the post-login redirect from the incoming
# Host header (preserved by both IIS in prod and the Vite dev proxy in dev —
# see frontend/vite.config.ts). Only set this if you introduce a proxy layer
# that rewrites the Host header and can't be configured to preserve it.
FRONTEND_URL=
# Comma-separated emails always treated as administrator and
# auto-provisioned into dbo.User on first login. Everyone else must
# already have a row in dbo.User (add them via Setup > Users).
BOOTSTRAP_ADMIN_EMAILS=
